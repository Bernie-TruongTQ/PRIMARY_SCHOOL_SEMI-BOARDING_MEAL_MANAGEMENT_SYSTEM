// ============================================================
// PRIMARY SCHOOL SEMI-BOARDING MEAL MANAGEMENT SYSTEM
// Scope: Meal Participation Management | Meal Demand & Quantity
//        Management | Meal Preparation
// ============================================================

Project primary_school_semi_boarding_meal_management_system {
  database_type: 'PostgreSQL'
  Note: '''
    # Primary School Semi-Boarding Meal Management System
    Live interactive documentation: https://dbdocs.io/tqtolympia/PRIMARY-SCHOOL-SEMI-BOARDING-MEAL-MANAGEMENT-SYSTEM
    Scope: Meal Participation Management | Meal Demand & Quantity Management | Meal Preparation
  '''
}

// ---------------- Reference tables (simplified) ----------------
// Full definitions live in their own modules; kept minimal here
// only to let DBML render the relationships correctly.

Table students {
  id integer [pk, increment]
  full_name varchar
  class_name varchar
  eligibility_status varchar
  Note: 'Simplified reference - see Student Meal Eligibility Management'
}

Table users {
  id integer [pk, increment]
  full_name varchar
  role varchar
  Note: 'Staff / kitchen users performing actions'
}

Table meal_schedules {
  id integer [pk, increment]
  meal_date date
  meal_type meal_type_enum
  menu_id integer
  Note: 'Simplified reference - see Meal Schedule Management'
}

Table dishes {
  id integer [pk, increment]
  name varchar
  status varchar
  Note: 'Simplified reference - see Dish Management'
}

Table ingredients {
  id integer [pk, increment]
  name varchar
  unit varchar
  Note: 'Simplified reference - see Inventory Management'
}

Table meal_registrations {
  id integer [pk, increment]
  student_id integer
  meal_schedule_id integer
  status varchar
  Note: 'Simplified reference - see Meal Registration Management'
}

// ---------------------------- Enums -----------------------------

Enum meal_type_enum {
  breakfast
  lunch
  dinner
  snack
}

Enum participation_status_enum {
  pending
  recorded
  confirmed
  cancelled
}

Enum participation_change_type_enum {
  status_update
  correction
  reschedule
}

Enum demand_determination_method_enum {
  participation_based
  manual_forecast
  historical_average
}

Enum demand_status_enum {
  draft
  calculated
  confirmed
  revised
}

Enum demand_change_type_enum {
  quantity_increase
  quantity_decrease
  dish_adjustment
  cancellation
}

Enum prep_plan_status_enum {
  planned
  in_progress
  completed
  cancelled
}

Enum allocation_status_enum {
  allocated
  adjusted
  returned
}

Enum prep_record_status_enum {
  in_progress
  completed
}

Enum confirmation_status_enum {
  matched
  discrepancy
}

// ================================================================
// MODULE 1: MEAL PARTICIPATION MANAGEMENT
// (Record / Manage Changes / Confirm Meal Participation)
// ================================================================

Table meal_participations {
  id integer [pk, increment]
  student_id integer [not null]
  meal_schedule_id integer [not null]
  meal_registration_id integer
  meal_date date [not null]
  meal_type meal_type_enum [not null]
  status participation_status_enum [not null, default: 'pending']
  recorded_by integer
  recorded_at datetime
  confirmed_by integer
  confirmed_at datetime
  notes varchar
  created_at datetime [default: `now()`]
  updated_at datetime

  indexes {
    (student_id, meal_schedule_id) [unique, name: 'uq_student_meal_schedule']
    (meal_date, meal_type)
  }

  Note: 'Records that a student actually took part in a specific meal (Record / Confirm Meal Participation)'
}

Ref: meal_participations.student_id > students.id
Ref: meal_participations.meal_schedule_id > meal_schedules.id
Ref: meal_participations.meal_registration_id > meal_registrations.id
Ref: meal_participations.recorded_by > users.id
Ref: meal_participations.confirmed_by > users.id

Table meal_participation_changes {
  id integer [pk, increment]
  meal_participation_id integer [not null]
  change_type participation_change_type_enum [not null]
  old_status participation_status_enum
  new_status participation_status_enum
  reason varchar
  changed_by integer [not null]
  changed_at datetime [default: `now()`]

  Note: 'Audit trail for Manage Participation Changes'
}

Ref: meal_participation_changes.meal_participation_id > meal_participations.id
Ref: meal_participation_changes.changed_by > users.id

// ================================================================
// MODULE 2: MEAL DEMAND & QUANTITY MANAGEMENT
// (Determine Demand / Calculate Expected Quantity / Manage Changes)
// ================================================================

Table meal_demands {
  id integer [pk, increment]
  meal_schedule_id integer [not null]
  meal_date date [not null]
  meal_type meal_type_enum [not null]
  determined_quantity integer [not null, note: 'total headcount / servings determined']
  determination_method demand_determination_method_enum [not null, default: 'participation_based']
  status demand_status_enum [not null, default: 'draft']
  determined_by integer
  determined_at datetime
  confirmed_by integer
  confirmed_at datetime
  created_at datetime [default: `now()`]
  updated_at datetime

  indexes {
    (meal_schedule_id) [unique]
  }

  Note: 'Determine Meal Demand - aggregated from confirmed meal_participations for that meal_schedule'
}

Ref: meal_demands.meal_schedule_id > meal_schedules.id
Ref: meal_demands.determined_by > users.id
Ref: meal_demands.confirmed_by > users.id

Table meal_demand_dish_quantities {
  id integer [pk, increment]
  meal_demand_id integer [not null]
  dish_id integer [not null]
  expected_quantity decimal [not null]
  unit varchar [not null]
  calculated_by integer
  calculated_at datetime [default: `now()`]

  indexes {
    (meal_demand_id, dish_id) [unique, name: 'uq_demand_dish']
  }

  Note: 'Calculate Expected Meal Quantity per dish (determined_quantity x recipe portion size)'
}

Ref: meal_demand_dish_quantities.meal_demand_id > meal_demands.id
Ref: meal_demand_dish_quantities.dish_id > dishes.id
Ref: meal_demand_dish_quantities.calculated_by > users.id

Table meal_demand_changes {
  id integer [pk, increment]
  meal_demand_id integer [not null]
  change_type demand_change_type_enum [not null]
  old_quantity integer
  new_quantity integer
  reason varchar
  changed_by integer [not null]
  changed_at datetime [default: `now()`]

  Note: 'Audit trail for Manage Meal Demand & Quantity Changes'
}

Ref: meal_demand_changes.meal_demand_id > meal_demands.id
Ref: meal_demand_changes.changed_by > users.id

// ================================================================
// MODULE 3: MEAL PREPARATION
// (Plan / Ingredient Allocation / Record / Confirm Prepared Qty)
// ================================================================

Table meal_preparation_plans {
  id integer [pk, increment]
  meal_demand_id integer [not null]
  meal_schedule_id integer [not null]
  planned_date date [not null]
  meal_type meal_type_enum [not null]
  status prep_plan_status_enum [not null, default: 'planned']
  planned_by integer
  planned_at datetime [default: `now()`]

  indexes {
    (meal_demand_id) [unique]
  }

  Note: 'Plan Meal Preparation, built from a confirmed meal_demand'
}

Ref: meal_preparation_plans.meal_demand_id > meal_demands.id
Ref: meal_preparation_plans.meal_schedule_id > meal_schedules.id
Ref: meal_preparation_plans.planned_by > users.id

Table meal_preparation_plan_dishes {
  id integer [pk, increment]
  preparation_plan_id integer [not null]
  dish_id integer [not null]
  planned_quantity decimal [not null]
  unit varchar [not null]

  indexes {
    (preparation_plan_id, dish_id) [unique, name: 'uq_plan_dish']
  }

  Note: 'Dish-level breakdown of a preparation plan, seeded from meal_demand_dish_quantities'
}

Ref: meal_preparation_plan_dishes.preparation_plan_id > meal_preparation_plans.id
Ref: meal_preparation_plan_dishes.dish_id > dishes.id

Table ingredient_allocations {
  id integer [pk, increment]
  preparation_plan_id integer [not null]
  ingredient_id integer [not null]
  allocated_quantity decimal [not null]
  unit varchar [not null]
  status allocation_status_enum [not null, default: 'allocated']
  allocated_by integer
  allocated_at datetime [default: `now()`]
  notes varchar

  Note: 'Manage Ingredient Allocation - ingredients reserved from inventory for a preparation plan'
}

Ref: ingredient_allocations.preparation_plan_id > meal_preparation_plans.id
Ref: ingredient_allocations.ingredient_id > ingredients.id
Ref: ingredient_allocations.allocated_by > users.id

Table meal_preparations {
  id integer [pk, increment]
  preparation_plan_id integer [not null]
  prepared_by integer
  status prep_record_status_enum [not null, default: 'in_progress']
  started_at datetime
  completed_at datetime
  notes varchar

  indexes {
    (preparation_plan_id) [unique]
  }

  Note: 'Record Meal Preparation - actual cooking execution against a plan'
}

Ref: meal_preparations.preparation_plan_id > meal_preparation_plans.id
Ref: meal_preparations.prepared_by > users.id

Table meal_preparation_dish_records {
  id integer [pk, increment]
  meal_preparation_id integer [not null]
  dish_id integer [not null]
  prepared_quantity decimal [not null]
  unit varchar [not null]
  recorded_at datetime [default: `now()`]

  indexes {
    (meal_preparation_id, dish_id) [unique, name: 'uq_prep_dish']
  }

  Note: 'Actual quantity prepared per dish'
}

Ref: meal_preparation_dish_records.meal_preparation_id > meal_preparations.id
Ref: meal_preparation_dish_records.dish_id > dishes.id

Table prepared_quantity_confirmations {
  id integer [pk, increment]
  meal_preparation_dish_record_id integer [not null]
  confirmed_quantity decimal [not null]
  confirmation_status confirmation_status_enum [not null]
  discrepancy_reason varchar
  confirmed_by integer [not null]
  confirmed_at datetime [default: `now()`]

  Note: 'Confirm Prepared Quantity - verification step comparing planned vs prepared vs confirmed'
}

Ref: prepared_quantity_confirmations.meal_preparation_dish_record_id > meal_preparation_dish_records.id
Ref: prepared_quantity_confirmations.confirmed_by > users.id
