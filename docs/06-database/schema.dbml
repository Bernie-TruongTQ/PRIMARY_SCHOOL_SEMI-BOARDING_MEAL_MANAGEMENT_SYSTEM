// ============================================================================
// PRIMARY SCHOOL SEMI-BOARDING MEAL MANAGEMENT SYSTEM
// DATABASE PERSISTENCE SCHEMA (DBML)
//
// Canonical Source of Truth for Database Architecture
// Architecture Alignment:
//   - arc42: 04-solution-strategy, 05-building-block-view, 06-runtime-view,
//            08-crosscutting-concepts, 09-architecture-decisions, 12-glossary
//   - C4 Model: Containers & Components (Domains 1 to 8)
//   - Docs: 01-top-down (MVP baseline), 02-core-features (INVEST requirements),
//           03-roles-usecases (Fixed 4-Role RBAC), 04-information-architecture
//
// Operating Model: External Catering Vendor (Dedicated Lunch-Only Scope)
// Database Engine: PostgreSQL 15 (ACID-compliant relational store)
// ============================================================================

Project primary_school_semi_boarding_meal_management_system {
  database_type: 'PostgreSQL'
  Note: '''
    # Primary School Semi-Boarding Meal Management System
    Relational persistence schema supporting the 8 business domains and the daily
    Lunch-Only operational cycle under the External Catering Vendor Operating Model:
      1. 08:30 AM: Classroom Attendance Roll-Call & Roster Cutoff Lockdown
      2. 08:45 AM: Lunch Demand Rollup, Safety Buffer & Catering PO Dispatch
      3. 10:30 AM: Delivery Dock Receiving & 3-Step Safety Inspection (Decision 1246/QD-BYT)
      4. 11:00 AM: Classroom Meal Trolley Distribution
      5. 13:00 PM: Post-Lunch 3-Way Quantity Reconciliation & Payables Accrual
      6. Monthly: Automated Student Fee Billing (with excused absence credits) & VietQR Reconciliation
  '''
}

// ============================================================================
// GLOBAL ENUMS & DOMAIN TYPES
// ============================================================================

Enum meal_type_enum {
  lunch [note: 'Primary school semi-boarding strictly operates on dedicated Lunch-only scope']
}

Enum fixed_role_enum {
  ADM [note: 'School Administrator / Principal - Master setup, calendars, 1-level menu approval, user accounts']
  MGR [note: 'Semi-Boarding Coordinator - Roll-call monitoring, demand aggregation, caterer dispatch, receiving, distribution, reconciliation']
  ACC [note: 'School Accountant - Meal fee schedules, billing batches, VietQR collection, caterer payables']
  PAR [note: 'Parent / Guardian - Program registration, allergy profile, menu viewing, electronic bill payments']
}

Enum eligibility_status_enum {
  eligible
  ineligible
  pending_review
}

Enum registration_status_enum {
  active
  on_leave
  cancelled
}

Enum participation_status_enum {
  present
  absent_excused
  absent_unexcused
}

Enum participation_change_type_enum {
  status_update
  absence_logging
  emergency_correction
}

Enum menu_approval_status_enum {
  draft
  submitted
  approved
  rejected
}

Enum dish_course_type_enum {
  main_entree
  side_dish
  soup
  dessert
}

Enum allergen_type_enum {
  peanut
  tree_nut
  seafood
  shellfish
  egg
  cow_milk
  soy
  wheat_gluten
  other
}

Enum allergy_severity_enum {
  mild
  moderate
  severe_anaphylaxis
}

Enum demand_determination_method_enum {
  attendance_based
  historical_forecast
  manual_adjustment
}

Enum demand_status_enum {
  draft
  calculated
  confirmed
  revised
}

Enum demand_change_type_enum {
  quantity_increase
  quantity_decrease
  dish_adjustment
  cancellation
}

Enum catering_order_status_enum {
  draft
  dispatched
  acknowledged
  delivered
  cancelled
}

Enum delivery_status_enum {
  arrived
  inspecting
  accepted
  rejected
}

Enum inspection_result_enum {
  passed
  rejected
  conditional_acceptance
}

Enum distribution_status_enum {
  preparing
  dispatched_to_class
  delivered
}

Enum reconciliation_variance_type_enum {
  exact_match
  vendor_shortfall
  excess_leftover
  damaged_spillage
}

Enum bill_status_enum {
  unpaid
  partial
  paid
}

Enum payment_method_enum {
  vietqr_bank_transfer
  cash
  bank_transfer_manual
}

// ============================================================================
// DOMAIN 8: MASTER DATA & SYSTEM CONFIGURATION (F-MST)
// ============================================================================

Table school_years {
  id integer [pk, increment]
  code varchar(20) [not null, unique, note: 'e.g., 2026-2027']
  name varchar(100) [not null]
  start_date date [not null]
  end_date date [not null]
  is_active boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]

  Note: 'Academic school year definition'
}

Table semesters {
  id integer [pk, increment]
  school_year_id integer [not null]
  code varchar(20) [not null, note: 'e.g., SEM1, SEM2']
  name varchar(100) [not null]
  start_date date [not null]
  end_date date [not null]
  is_active boolean [not null, default: false]

  indexes {
    (school_year_id, code) [unique, name: 'uq_semester_year_code']
  }

  Note: 'Academic semester within a school year'
}

Ref: semesters.school_year_id > school_years.id [delete: cascade]

Table grades {
  id integer [pk, increment]
  grade_level integer [not null, unique, note: '1 to 5 for primary school']
  name varchar(50) [not null, note: 'e.g., Khối 1']

  Note: 'Primary school grade level definition'
}

Table classes {
  id integer [pk, increment]
  school_year_id integer [not null]
  grade_id integer [not null]
  name varchar(50) [not null, note: 'e.g., 1A, 2B, 3C']
  homeroom_teacher_id integer [null]
  classroom_location varchar(100) [null, note: 'Building / room number for meal trolley dispatch']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (school_year_id, name) [unique, name: 'uq_class_year_name']
  }

  Note: 'Classroom entity where morning roll-call and 11:00 AM meal tray delivery occurs'
}

Ref: classes.school_year_id > school_years.id
Ref: classes.grade_id > grades.id

Table students {
  id integer [pk, increment]
  student_code varchar(50) [not null, unique, note: 'Official school student registration ID']
  full_name varchar(150) [not null]
  date_of_birth date [not null]
  gender varchar(10) [null]
  current_class_id integer [not null]
  status varchar(30) [not null, default: 'active']
  dietary_notes varchar(500) [null, note: 'General dietary preferences or religious notes']
  has_severe_allergy boolean [not null, default: false, note: 'Pre-computed flag to speed up allergen warning lookups']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [null]

  indexes {
    (current_class_id)
    (student_code)
  }

  Note: 'Master student directory synchronised with School Information System (SIS)'
}

Ref: students.current_class_id > classes.id

Table meal_calendars {
  id integer [pk, increment]
  calendar_date date [not null, unique]
  is_serving_day boolean [not null, default: true, note: 'Default serving days are Monday through Friday']
  description varchar(255) [null]

  indexes {
    (calendar_date)
  }

  Note: 'Master calendar governing lunch service eligibility and fee billing day exclusions'
}

Table holidays {
  id integer [pk, increment]
  school_year_id integer [not null]
  name varchar(150) [not null, note: 'e.g., Tet Holiday, Teacher Day']
  start_date date [not null]
  end_date date [not null]
  description varchar(255) [null]

  indexes {
    (start_date, end_date)
  }

  Note: 'Institutional and national non-serving holiday periods automatically excluded from billing'
}

Ref: holidays.school_year_id > school_years.id

// ============================================================================
// DOMAIN 6: USER & ACCESS MANAGEMENT (FIXED 4-ROLE RBAC) (F-USR)
// ============================================================================

Table roles {
  id integer [pk, increment]
  code fixed_role_enum [not null, unique]
  name varchar(100) [not null]
  description varchar(255) [null]

  Note: 'Fixed 4-Role RBAC Model: ADM, MGR, ACC, PAR (no ad-hoc runtime overrides)'
}

Table users {
  id integer [pk, increment]
  username varchar(100) [not null, unique]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  full_name varchar(150) [not null]
  phone varchar(30) [null]
  role_id integer [not null]
  is_active boolean [not null, default: true]
  last_login_at timestamp [null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [null]

  indexes {
    (role_id)
    (email)
  }

  Note: 'User accounts authenticated via JWT; maps directly to the fixed role model'
}

Ref: users.role_id > roles.id
Ref: classes.homeroom_teacher_id > users.id

Table parent_student_associations {
  id integer [pk, increment]
  parent_user_id integer [not null]
  student_id integer [not null]
  relationship_type varchar(50) [not null, default: 'parent', note: 'father, mother, guardian']
  is_primary_contact boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (parent_user_id, student_id) [unique, name: 'uq_parent_student']
  }

  Note: 'Associates parent user accounts with their enrolled children for portal isolation'
}

Ref: parent_student_associations.parent_user_id > users.id
Ref: parent_student_associations.student_id > students.id

// ============================================================================
// DOMAIN 7: NUTRITION & FOOD ALLERGY MANAGEMENT (F-NUT)
// ============================================================================

Table student_allergies {
  id integer [pk, increment]
  student_id integer [not null]
  allergen_type allergen_type_enum [not null]
  allergen_name varchar(100) [not null, note: 'Specific allergen, e.g., Peanut, Shrimp, Crab, Cow Milk']
  severity allergy_severity_enum [not null, default: 'moderate']
  medical_action_plan text [null, note: 'First aid and emergency protocol if exposed']
  diagnosed_by varchar(150) [null, note: 'Doctor / hospital medical certificate reference']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (student_id, allergen_type) [unique, name: 'uq_student_allergen']
  }

  Note: 'Medical allergy profiles declared by parents or school medical staff for safety alerts'
}

Ref: student_allergies.student_id > students.id

Table ingredients {
  id integer [pk, increment]
  name varchar(150) [not null, unique]
  allergen_type allergen_type_enum [null, note: 'Allergen category if this ingredient triggers allergies']
  description varchar(255) [null]

  Note: 'Food ingredients used in menu dishes to evaluate recipe-allergy conflicts'
}

Table dishes {
  id integer [pk, increment]
  name varchar(150) [not null, unique]
  course_type dish_course_type_enum [not null]
  standard_portion_weight decimal(8,2) [not null, note: 'Standard portion size per child']
  unit varchar(30) [not null, default: 'grams', note: 'grams, ml, pieces']
  calories_kcal decimal(6,2) [null]
  status varchar(30) [not null, default: 'active']
  description text [null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (course_type)
  }

  Note: 'Standard school lunch culinary and nutritional dish catalog'
}

Table dish_ingredients {
  id integer [pk, increment]
  dish_id integer [not null]
  ingredient_id integer [not null]
  is_mandatory boolean [not null, default: true]

  indexes {
    (dish_id, ingredient_id) [unique, name: 'uq_dish_ingredient']
  }

  Note: 'Recipe ingredient composition enabling automated downstream allergen conflict detection'
}

Ref: dish_ingredients.dish_id > dishes.id
Ref: dish_ingredients.ingredient_id > ingredients.id

// ============================================================================
// DOMAIN 2: MEAL PLANNING & MENU MANAGEMENT (F-PLN)
// ============================================================================

Table menus {
  id integer [pk, increment]
  school_year_id integer [not null]
  week_number integer [not null, note: 'School calendar week number, 1-52']
  name varchar(150) [not null, note: 'e.g., Thuc don Tuan 42']
  approval_status menu_approval_status_enum [not null, default: 'draft']
  created_by integer [not null]
  approved_by integer [null, note: 'Single-level approval by School Administrator / Principal']
  approved_at timestamp [null]
  rejection_reason varchar(500) [null]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [null]

  indexes {
    (school_year_id, week_number) [unique, name: 'uq_menu_year_week']
  }

  Note: 'Weekly lunch menu subject to single-level approval by School Administrator'
}

Ref: menus.school_year_id > school_years.id
Ref: menus.created_by > users.id
Ref: menus.approved_by > users.id

Table menu_dishes {
  id integer [pk, increment]
  menu_id integer [not null]
  day_of_week integer [not null, note: '2=Monday, 3=Tuesday, ..., 6=Friday']
  dish_id integer [not null]

  indexes {
    (menu_id, day_of_week, dish_id) [unique, name: 'uq_menu_day_dish']
  }

  Note: 'Assignment of catalog dishes into the weekly menu for each school day'
}

Ref: menu_dishes.menu_id > menus.id [delete: cascade]
Ref: menu_dishes.dish_id > dishes.id

Table meal_schedules {
  id integer [pk, increment]
  meal_date date [not null, unique]
  meal_type meal_type_enum [not null, default: 'lunch']
  menu_id integer [not null]
  cutoff_time time [not null, default: '08:30:00', note: 'Attendance lock deadline']
  order_deadline_time time [not null, default: '08:45:00', note: 'Catering PO dispatch deadline']
  dock_arrival_time time [not null, default: '10:30:00', note: 'Delivery dock receiving window']
  distribution_time time [not null, default: '11:00:00', note: 'Classroom trolley distribution']
  reconciliation_time time [not null, default: '13:00:00', note: 'Post-lunch reconciliation window']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (meal_date)
  }

  Note: 'Daily meal schedule linking an approved menu with statutory operational timeline milestones'
}

Ref: meal_schedules.menu_id > menus.id

// ============================================================================
// DOMAIN 1: STUDENT MEAL & PARTICIPATION MANAGEMENT (F-PAR)
// ============================================================================

Table meal_eligibility_criteria {
  id integer [pk, increment]
  school_year_id integer [not null]
  name varchar(150) [not null]
  min_grade integer [not null, default: 1]
  max_grade integer [not null, default: 5]
  requires_health_clearance boolean [not null, default: true]
  is_active boolean [not null, default: true]

  Note: 'Rules and criteria determining student boarding eligibility'
}

Ref: meal_eligibility_criteria.school_year_id > school_years.id

Table student_meal_eligibilities {
  id integer [pk, increment]
  student_id integer [not null]
  criteria_id integer [not null]
  status eligibility_status_enum [not null, default: 'eligible']
  verified_by integer [null]
  verified_at timestamp [null]
  reason varchar(255) [null]

  indexes {
    (student_id, criteria_id) [unique, name: 'uq_student_criteria']
  }

  Note: 'Evaluation of student boarding program eligibility status'
}

Ref: student_meal_eligibilities.student_id > students.id
Ref: student_meal_eligibilities.criteria_id > meal_eligibility_criteria.id
Ref: student_meal_eligibilities.verified_by > users.id

Table meal_registrations {
  id integer [pk, increment]
  student_id integer [not null]
  semester_id integer [not null]
  status registration_status_enum [not null, default: 'active']
  dietary_notes varchar(500) [null]
  registered_by integer [not null]
  registered_at timestamp [not null, default: `now()`]
  cancelled_at timestamp [null]

  indexes {
    (student_id, semester_id) [unique, name: 'uq_student_semester_reg']
  }

  Note: 'Semester boarding program enrollment binding students to daily attendance rosters'
}

Ref: meal_registrations.student_id > students.id
Ref: meal_registrations.semester_id > semesters.id
Ref: meal_registrations.registered_by > users.id

Table meal_participations {
  id integer [pk, increment]
  student_id integer [not null]
  meal_schedule_id integer [not null]
  class_id integer [not null]
  meal_registration_id integer [null]
  status participation_status_enum [not null, default: 'present']
  is_locked boolean [not null, default: false, note: 'Hard locked at 08:30 AM by AttendanceCutoffGuard']
  recorded_by integer [not null, note: 'Homeroom teacher or substitute coordinator taking attendance']
  recorded_at timestamp [not null, default: `now()`]
  notes varchar(255) [null, note: 'Absence reason: sick leave, family business, etc.']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [null]

  indexes {
    (student_id, meal_schedule_id) [unique, name: 'uq_student_meal_schedule']
    (meal_schedule_id, class_id)
    (meal_schedule_id, status)
  }

  Note: 'Daily classroom lunch attendance record locked at 08:30 AM cutoff'
}

Ref: meal_participations.student_id > students.id
Ref: meal_participations.meal_schedule_id > meal_schedules.id
Ref: meal_participations.class_id > classes.id
Ref: meal_participations.meal_registration_id > meal_registrations.id
Ref: meal_participations.recorded_by > users.id

Table meal_participation_changes {
  id integer [pk, increment]
  meal_participation_id integer [not null]
  change_type participation_change_type_enum [not null]
  old_status participation_status_enum [not null]
  new_status participation_status_enum [not null]
  reason varchar(500) [not null, note: 'Mandatory justification for modifying locked attendance']
  changed_by integer [not null]
  changed_at timestamp [not null, default: `now()`]

  indexes {
    (meal_participation_id)
  }

  Note: 'Immutable audit trail capturing all attendance amendments post-roll-call'
}

Ref: meal_participation_changes.meal_participation_id > meal_participations.id
Ref: meal_participation_changes.changed_by > users.id

// ============================================================================
// DOMAIN 3: MEAL OPERATION (CATERING WORKFLOW & LIFECYCLE) (F-OPS)
// ============================================================================

Table meal_demands {
  id integer [pk, increment]
  meal_schedule_id integer [not null, unique]
  confirmed_attendance integer [not null, note: 'Aggregated net present students across all classrooms at 08:30 AM']
  special_dietary_count integer [not null, default: 0, note: 'Count of allergy-free or vegetarian trays required']
  buffer_rate decimal(4,3) [not null, default: 0.050, note: 'Safety buffer margin between 0.000 and 0.100 (default 5%)']
  buffer_quantity integer [not null, note: 'Calculated buffer portions: round(confirmed_attendance * buffer_rate)']
  final_demand_count integer [not null, note: 'Total order count: confirmed_attendance + buffer_quantity']
  determination_method demand_determination_method_enum [not null, default: 'attendance_based']
  status demand_status_enum [not null, default: 'draft']
  determined_by integer [not null]
  determined_at timestamp [not null, default: `now()`]
  confirmed_by integer [null]
  confirmed_at timestamp [null]

  indexes {
    (meal_schedule_id)
  }

  Note: 'Aggregated daily session demand calculation with safety buffer margin'
}

Ref: meal_demands.meal_schedule_id > meal_schedules.id
Ref: meal_demands.determined_by > users.id
Ref: meal_demands.confirmed_by > users.id

Table meal_demand_dish_quantities {
  id integer [pk, increment]
  meal_demand_id integer [not null]
  dish_id integer [not null]
  expected_quantity decimal(10,2) [not null, note: 'Calculated dish production quantity in kg, liters, or portions']
  unit varchar(30) [not null]
  calculated_at timestamp [not null, default: `now()`]

  indexes {
    (meal_demand_id, dish_id) [unique, name: 'uq_demand_dish']
  }

  Note: 'Dish-level portion requirements calculated by MenuDishQuantityCalculator'
}

Ref: meal_demand_dish_quantities.meal_demand_id > meal_demands.id
Ref: meal_demand_dish_quantities.dish_id > dishes.id

Table meal_demand_changes {
  id integer [pk, increment]
  meal_demand_id integer [not null]
  change_type demand_change_type_enum [not null]
  old_quantity integer [not null]
  new_quantity integer [not null]
  reason varchar(500) [not null]
  changed_by integer [not null]
  changed_at timestamp [not null, default: `now()`]

  indexes {
    (meal_demand_id)
  }

  Note: 'Audit log tracking post-calculation adjustments to meal demand'
}

Ref: meal_demand_changes.meal_demand_id > meal_demands.id
Ref: meal_demand_changes.changed_by > users.id

Table catering_orders {
  id integer [pk, increment]
  order_code varchar(50) [not null, unique, note: 'e.g., PO-20261012-01']
  meal_demand_id integer [not null, unique]
  vendor_name varchar(150) [not null, default: 'Licensed Catering Partner']
  total_ordered_portions integer [not null]
  standard_portions integer [not null]
  special_dietary_portions integer [not null]
  target_delivery_time timestamp [not null, note: 'Standard dock arrival: 10:30 AM']
  status catering_order_status_enum [not null, default: 'draft']
  dispatched_at timestamp [null, note: 'Must execute before 08:45 AM Order Deadline']
  dispatched_by integer [null]
  vendor_acknowledged_at timestamp [null]
  vendor_tracking_reference varchar(100) [null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (order_code)
    (meal_demand_id)
  }

  Note: 'Formal purchase order dispatched electronically to the external Catering Vendor before 08:45 AM'
}

Ref: catering_orders.meal_demand_id > meal_demands.id
Ref: catering_orders.dispatched_by > users.id

Table meal_deliveries {
  id integer [pk, increment]
  catering_order_id integer [not null, unique]
  arrival_time timestamp [not null, default: `now()`, note: 'Recorded when vehicle arrives at school dock (~10:30 AM)']
  vehicle_plate varchar(30) [not null, note: 'Delivery vehicle registration plate number']
  driver_name varchar(100) [null]
  thermal_container_count integer [not null, note: 'Number of insulated food delivery containers unloaded']
  delivered_portions integer [not null, note: 'Declared delivered portion count on delivery voucher']
  received_by integer [not null, note: 'Coordinator receiving the delivery at dock']
  status delivery_status_enum [not null, default: 'arrived']
  created_at timestamp [not null, default: `now()`]

  indexes {
    (catering_order_id)
  }

  Note: 'Dock receiving record for hot meal shipment delivered by external catering vendor'
}

Ref: meal_deliveries.catering_order_id > catering_orders.id
Ref: meal_deliveries.received_by > users.id

Table meal_inspections {
  id integer [pk, increment]
  meal_delivery_id integer [not null, unique]
  inspector_id integer [not null, note: 'School Nurse or Coordinator executing 3-Step Food Safety Inspection']
  core_temperature decimal(4,1) [not null, note: 'Digital probe thermometer reading in Celsius. Must be >= 65.0 C (Decision 1246/QD-BYT)']
  container_seals_intact boolean [not null, note: 'Verification of tamper-evident container seals']
  sensory_eval_pass boolean [not null, note: 'Visual, aroma, and texture sensory check']
  retention_sample_taken boolean [not null, default: true, note: 'Mandatory 24h food retention sample jar sealed and stored']
  sample_photo_url varchar(500) [null, note: 'Photo URL of sealed 24h retention sample jars in S3 store']
  thermometer_photo_url varchar(500) [null, note: 'Photo URL of digital thermometer probe readout in S3 store']
  inspection_result inspection_result_enum [not null]
  rejection_reason varchar(500) [null]
  inspected_at timestamp [not null, default: `now()`, note: 'Completed at 10:30 AM receiving window']

  indexes {
    (meal_delivery_id)
  }

  Note: 'Statutory 3-step food safety inspection record enforced by QualityInspectionValidator (QĐ 1246/QĐ-BYT)'
}

Ref: meal_inspections.meal_delivery_id > meal_deliveries.id
Ref: meal_inspections.inspector_id > users.id

Table meal_distributions {
  id integer [pk, increment]
  meal_delivery_id integer [not null]
  class_id integer [not null]
  allocated_portions integer [not null, note: 'Number of meal trays loaded onto classroom trolley']
  special_dietary_portions integer [not null, default: 0, note: 'Dedicated allergen-free trays for this class']
  distributed_at timestamp [not null, default: `now()`, note: 'Trolley dispatch timestamp (~11:00 AM)']
  distributed_by integer [not null]
  received_by_teacher_id integer [null]
  status distribution_status_enum [not null, default: 'delivered']

  indexes {
    (meal_delivery_id, class_id) [unique, name: 'uq_delivery_class_distrib']
  }

  Note: 'Classroom trolley distribution log recording tray quantities dispatched for the 11:00 AM lunch window'
}

Ref: meal_distributions.meal_delivery_id > meal_deliveries.id
Ref: meal_distributions.class_id > classes.id
Ref: meal_distributions.distributed_by > users.id
Ref: meal_distributions.received_by_teacher_id > users.id

Table meal_reconciliations {
  id integer [pk, increment]
  catering_order_id integer [not null, unique]
  ordered_quantity integer [not null, note: 'Final order headcount sent to caterer at 08:45 AM']
  delivered_quantity integer [not null, note: 'Verified portions delivered by caterer at 10:30 AM']
  consumed_quantity integer [not null, note: 'Actual portions consumed by present students during lunch']
  leftover_quantity integer [not null, note: 'Unserved portions (buffer surplus or absent deductions)']
  delivery_variance integer [not null, note: 'delivered_quantity - ordered_quantity']
  consumption_variance integer [not null, note: 'consumed_quantity - delivered_quantity']
  accepted_payable_quantity integer [not null, note: 'min(ordered_quantity, delivered_and_accepted_quantity) passed to Accountant']
  variance_type reconciliation_variance_type_enum [not null, default: 'exact_match']
  reconciled_by integer [not null]
  reconciled_at timestamp [not null, default: `now()`, note: 'Post-lunch reconciliation window (~13:00 PM)']

  indexes {
    (catering_order_id)
  }

  Note: 'Daily 13:00 PM 3-way quantity reconciliation executed by MealReconciliationEngine'
}

Ref: meal_reconciliations.catering_order_id > catering_orders.id
Ref: meal_reconciliations.reconciled_by > users.id

Table meal_discrepancies {
  id integer [pk, increment]
  meal_reconciliation_id integer [not null]
  discrepancy_count integer [not null]
  discrepancy_reason varchar(500) [not null, note: 'Mandatory reason, e.g., Vendor Shortfall: 10 meals missing, Spillage during transit']
  financial_impact_note varchar(255) [null, note: 'Deducted from vendor invoice / absorbed by school reserve']
  resolved_by integer [not null]
  resolved_at timestamp [not null, default: `now()`]

  indexes {
    (meal_reconciliation_id)
  }

  Note: 'Mandatory justification and financial resolution log for reconciliation variances'
}

Ref: meal_discrepancies.meal_reconciliation_id > meal_reconciliations.id
Ref: meal_discrepancies.resolved_by > users.id

// ============================================================================
// DOMAIN 4: MEAL FEE & COST MANAGEMENT (F-FEE)
// ============================================================================

Table meal_fee_configs {
  id integer [pk, increment]
  school_year_id integer [not null]
  name varchar(100) [not null, note: 'e.g., Bieu phi Ban tru HK1 2026-2027']
  meal_fee_rate decimal(10,2) [not null, note: 'Fee charged to parents per lunch meal, e.g., 35000.00 VND']
  caterer_cost_rate decimal(10,2) [not null, note: 'Contracted unit cost paid to caterer per meal, e.g., 28000.00 VND']
  effective_from date [not null]
  effective_to date [not null]
  is_active boolean [not null, default: true]
  created_by integer [not null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (school_year_id, is_active)
  }

  Note: 'Master meal fee unit price and caterer cost schedule configured by School Accountant'
}

Ref: meal_fee_configs.school_year_id > school_years.id
Ref: meal_fee_configs.created_by > users.id

Table student_meal_bills {
  id integer [pk, increment]
  student_id integer [not null]
  fee_config_id integer [not null]
  billing_month varchar(7) [not null, note: 'YYYY-MM format, e.g., 2026-10']
  total_scheduled_meals integer [not null, note: 'Total serving days in month excluding weekends and holidays']
  attended_meals integer [not null, note: 'Total recorded present meals']
  credited_absences integer [not null, note: 'Excused absences logged before cutoff refunded/credited']
  unexcused_absences integer [not null, note: 'Unexcused late absences charged without credit']
  total_chargeable_meals integer [not null, note: 'attended_meals + unexcused_absences']
  unit_price decimal(10,2) [not null]
  total_amount decimal(12,2) [not null, note: 'total_chargeable_meals * unit_price']
  paid_amount decimal(12,2) [not null, default: 0.00]
  payment_status bill_status_enum [not null, default: 'unpaid']
  vietqr_payload varchar(500) [null, note: 'Dynamic VietQR payment payload containing invoice ID and exact amount']
  issued_at timestamp [not null, default: `now()`]
  due_date date [not null]

  indexes {
    (student_id, billing_month) [unique, name: 'uq_student_bill_month']
    (payment_status)
  }

  Note: 'Monthly student meal bill generated by ChargeableMealBillingCalculator'
}

Ref: student_meal_bills.student_id > students.id
Ref: student_meal_bills.fee_config_id > meal_fee_configs.id

Table student_billing_items {
  id integer [pk, increment]
  student_meal_bill_id integer [not null]
  meal_schedule_id integer [not null]
  meal_participation_id integer [null]
  is_charged boolean [not null]
  credit_reason varchar(255) [null, note: 'Excused absence credited / School holiday']

  indexes {
    (student_meal_bill_id, meal_schedule_id) [unique, name: 'uq_bill_item_schedule']
  }

  Note: 'Itemized day-by-day audit trail demonstrating why each lunch date was billed or credited'
}

Ref: student_billing_items.student_meal_bill_id > student_meal_bills.id [delete: cascade]
Ref: student_billing_items.meal_schedule_id > meal_schedules.id
Ref: student_billing_items.meal_participation_id > meal_participations.id

Table meal_payments {
  id integer [pk, increment]
  student_meal_bill_id integer [not null]
  payment_code varchar(50) [not null, unique, note: 'Receipt / transaction reference code']
  amount decimal(12,2) [not null]
  payment_method payment_method_enum [not null, default: 'vietqr_bank_transfer']
  transaction_reference varchar(100) [null, note: 'Banking transaction reference from VietQR payment webhook']
  recorded_by integer [null, note: 'Accountant user ID or system webhook user']
  paid_at timestamp [not null, default: `now()`]
  notes varchar(255) [null]

  indexes {
    (student_meal_bill_id)
    (payment_code)
  }

  Note: 'Payment transaction recording parent fee settlements across 3 streamlined states'
}

Ref: meal_payments.student_meal_bill_id > student_meal_bills.id
Ref: meal_payments.recorded_by > users.id

Table vendor_payables {
  id integer [pk, increment]
  fee_config_id integer [not null]
  catering_order_id integer [not null, unique]
  reconciled_billable_portions integer [not null, note: 'accepted_payable_quantity from meal_reconciliations']
  unit_cost decimal(10,2) [not null, note: 'Contracted cost rate from meal_fee_configs']
  total_payable_amount decimal(12,2) [not null, note: 'reconciled_billable_portions * unit_cost']
  is_settled boolean [not null, default: false]
  settled_at timestamp [null]
  settlement_reference varchar(100) [null]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (catering_order_id)
    (is_settled)
  }

  Note: 'Accrued caterer liabilities derived by VendorCostPayableAccrualService based on reconciled deliveries'
}

Ref: vendor_payables.fee_config_id > meal_fee_configs.id
Ref: vendor_payables.catering_order_id > catering_orders.id
